# Copy to .env when custom configuration is needed. Defaults use public RIPE data.
# Published image: ghcr.io/mraliscoder/ripe-db-audit:latest
# AUDIT_IMAGE=ghcr.io/mraliscoder/ripe-db-audit:latest
AUDIT_BIND=127.0.0.1
AUDIT_PORT=8090
AUDIT_MAX_JOBS=2
AUDIT_MAX_OBJECTS=20000
AUDIT_MAX_ROUTING_QUERIES=4096
AUDIT_JOB_TIMEOUT=1800

# Optional public origins for reverse-proxy deployments (comma-separated, no paths).
# Same-origin browser requests work automatically through HTTPS proxies.
AUDIT_ALLOWED_ORIGINS=

# Optional trusted proxy addresses/networks for Uvicorn forwarded headers.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Optional instance authentication.
AUDIT_ACCESS_TOKEN=

# Optional private LIR Portal inventory; requires AUDIT_ACCESS_TOKEN.
RIPE_API_KEYS_JSON={}

# Optional signed HTTPS callback; leave both empty to disable it.
AUDIT_WEBHOOK_URL=
AUDIT_WEBHOOK_SECRET=
